# ==============================================================================
# Medrella Healthcare — Production Environment Variables
# ==============================================================================

# Required for Vercel / Production Deployment: Neon Serverless PostgreSQL Connection String
# Get your free serverless database URL at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Required for Production: Cryptographically secure secret key for signed session tokens
# and HMAC-SHA256 unsubscribe links. Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-strong-32-byte-secret-key-for-production"

# Production base URL (used to generate valid email links and unsubscribe tokens)
APP_URL="https://medrella-healthcare.vercel.app"

# Optional (Development only): Set to "true" to automatically seed sample specialists during offline dev
# Never set to "true" in production.
ENABLE_SEED_DATA="false"

# Required only when running `npm run db:seed`: login password for the 8 seeded landing-page doctors
# (e.g. ananya.sharma@medrella.com). 8+ characters. Existing doctor accounts keep their current password.
SEED_DOCTOR_PASSWORD="choose-a-strong-password"

# ==============================================================================
# Administrative Access Control
# Comma-separated list of administrative email accounts permitted to access
# the Notification Dead-Letter Outbox monitoring dashboard at /admin/notifications.
# All other authenticated users receive 404 (notFound).
# ==============================================================================
ADMIN_EMAILS="your-login-email@example.com"

# ==============================================================================
# Razorpay Payment Gateway (Test Mode) Configuration
# Development / tests: when RAZORPAY_KEY_ID is unset, the app uses the in-memory Mock
# gateway (also forced by USE_MOCK_PAYMENTS=true).
# PRODUCTION: Razorpay keys are REQUIRED. The mock is never used in production; payments fail
# closed (booking shows "not available") if the keys are missing.
# MOCK_REFUND_STATUS=pending|failed makes the mock answer like a slow/failed Razorpay refund.
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_test_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Duration in minutes to hold an outpatient slot during checkout (default: 10)
PAYMENT_HOLD_MINUTES="10"

# Secret protecting cron endpoints /api/cron/payments and /api/cron/notifications.
# REQUIRED in production: without it the endpoints refuse to run (503).
CRON_SECRET="your_cron_secret_token_here"

# ==============================================================================
# Reliable Email Notification Outbox Configuration (Task 5)
# Email delivery provider: Resend API (https://resend.com)
# In development: unset key uses ConsoleChannel (prints to stdout and marks SENT).
# In production: unset key fails closed (messages remain PENDING/FAILED; never falsely marked SENT).
# ==============================================================================
# EMAIL_PROVIDER: "brevo" or "resend". If unset, Brevo is used when BREVO_API_KEY is set.
EMAIL_PROVIDER="brevo"
# Brevo (https://brevo.com): free plan, sends to any recipient. EMAIL_FROM must be a sender
# address you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
BREVO_API_KEY="your_brevo_api_key_here"
EMAIL_FROM="Medrella Healthcare <your-verified-sender@example.com>"
# Resend alternative (only delivers to your own address until you verify a domain):
RESEND_API_KEY=""

# Comma-separated offsets (in minutes) before appointment start time to schedule reminders.
# Evaluated strictly in Asia/Kolkata timezone. Default: 1440,120 (24 hours and 2 hours before).
REMINDER_OFFSETS_MINUTES="1440,120"
