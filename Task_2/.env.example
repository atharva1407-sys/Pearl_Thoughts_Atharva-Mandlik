# ==============================================================================
# Medrella Healthcare — Production Environment Variables
# ==============================================================================

# Required for Vercel / Production Deployment: Neon Serverless PostgreSQL Connection String
# Get your free serverless database URL at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Required for Production: Cryptographically secure secret key for signed session tokens
# Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-strong-32-byte-secret-key-for-production"

# Optional (Development only): Set to "true" to automatically seed sample specialists during offline dev
# Never set to "true" in production.
ENABLE_SEED_DATA="false"

# Required only when running `npm run db:seed`: login password for the 8 seeded landing-page doctors
# (e.g. ananya.sharma@medrella.com). 8+ characters. Existing doctor accounts keep their current password.
SEED_DOCTOR_PASSWORD="choose-a-strong-password"
